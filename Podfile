platform :ios, '15.0' # 与工程 IPHONEOS_DEPLOYMENT_TARGET (15.0) 保持一致
use_frameworks!

target 'QiGames' do
  # AdMob (Google Mobile Ads SDK) — 版本精确锁定 11.7.0
  pod 'Google-Mobile-Ads-SDK', '= 11.7.0'

  # Meta Audience Network
  pod 'FBAudienceNetwork'

  # Liftoff (Vungle SDK)
  pod 'VungleSDK-iOS'

  # Chartboost
  pod 'ChartboostSDK'

  # InMobi
  pod 'InMobiSDK'

  # Unity Ads
  pod 'UnityAds'
end
